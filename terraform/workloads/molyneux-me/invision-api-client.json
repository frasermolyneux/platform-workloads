{
    "name": "invision-api-client",
    "github": {
        "repository_analysis": {
            "profile": {
                "version": "repository-analysis-v1",
                "languages": [
                    "actions",
                    "csharp"
                ],
                "sonar": true
            },
            "sonar": {
                "recipe": {
                    "version": 1,
                    "driver": "dotnet",
                    "projectKey": "frasermolyneux_invision-api-client",
                    "sourceDirectory": "src",
                    "coverage": "cobertura"
                },
                "build": {
                    "kind": "dotnet",
                    "sdk": [
                        "9.0.x",
                        "10.0.x"
                    ],
                    "globalJson": "global.json",
                    "solution": ".",
                    "skipFormat": true,
                    "tests": true
                }
            },
            "cadence": {
                "dailyFreshness": true,
                "fullRescanMaximumHours": 168,
                "defaultBranchCancellation": false,
                "dispatch": {
                    "expectedRevision": true,
                    "force": true,
                    "defaultBranchOnly": true
                }
            }
        },
        "description": "Invision Community API client library used by the XtremeIdiots portal, published to NuGet.",
        "topics": [
            "dotnet",
            "api-client",
            "invision-community",
            "restsharp",
            "polly",
            "nuget",
            "github-actions"
        ],
        "add_sonarcloud_secrets": true,
        "add_nuget_environment": true,
        "visibility": "public",
        "rulesets": [
            {
                "name": "main-protection",
                "target": "branch",
                "enforcement": "active",
                "includes": [
                    "refs/heads/main"
                ],
                "excludes": [],
                "bypass_actors": [
                    {
                        "bypass_mode": "always",
                        "actor_id": 5,
                        "actor_type": "RepositoryRole"
                    }
                ],
                "rules": {
                    "required_status_checks": [
                        
                        {
                            "context": "dependabot-policy",
                            "integration_id": 15368
                        },
                        {
                            "context": "SonarCloud Code Analysis",
                            "integration_id": 12526
                        },
                        {
                            "context": "build-and-test",
                            "integration_id": 15368
                        },
                        {
                            "context": "quality / Code Quality",
                            "integration_id": 15368
                        },
                        {
                            "context": "devops-secure-scanning / DevOps Secure Scanning",
                            "integration_id": 15368
                        }
                    ],
                    "strict_required_status_checks_policy": true,
                    "do_not_enforce_on_create": false,
                    "pull_request": {
                        "allowed_merge_methods": [
                            "merge",
                            "rebase",
                            "squash"
                        ],
                        "required_approving_review_count": 0,
                        "dismiss_stale_reviews_on_push": true,
                        "require_code_owner_review": false,
                        "required_review_thread_resolution": true
                    },
                    "required_code_scanning": [
                        {
                            "tool": "CodeQL",
                            "alerts_threshold": "errors",
                            "security_alerts_threshold": "high_or_higher"
                        },
                        {
                            "tool": "SonarCloud",
                            "alerts_threshold": "errors",
                            "security_alerts_threshold": "high_or_higher"
                        }
                    ],
                    "required_signatures": false,
                    "required_linear_history": true,
                    "non_fast_forward": true
                }
            }
        ]
    }
}
