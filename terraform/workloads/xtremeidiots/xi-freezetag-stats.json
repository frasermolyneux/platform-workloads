{
    "name": "xi-freezetag-stats",
    "github": {
        "description": "FreezeTag log collection and statistics-generation workload for the XtremeIdiots community.",
        "topics": [
            "powershell",
            "sftp",
            "statistics",
            "automation",
            "bare-metal",
            "xtremeidiots"
        ],
        "add_sonarcloud_secrets": false,
        "add_nuget_environment": false,
        "visibility": "private"
    },
    "environments": [
        {
            "name": "Production",
            "subscription": "sub-platform-management",
            "connect_to_github": true,
            "locations": [
                "swedencentral"
            ],
            "resource_groups": [
                {
                    "name": "rg-{workload}-{env}-{location}"
                }
            ]
        }
    ]
}
