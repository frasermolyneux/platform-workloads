{
    "name": "platform-landing-zones",
    "github": {
        "repository_analysis": {
            "profile": {
                "version": "repository-analysis-v1",
                "languages": [
                    "actions",
                    "powershell",
                    "terraform"
                ],
                "sonar": false
            },
            "sonar": null,
            "cadence": {
                "dailyFreshness": true,
                "fullRescanMaximumHours": 168,
                "defaultBranchCancellation": false,
                "dispatch": {
                    "expectedRevision": true,
                    "force": true,
                    "defaultBranchOnly": true
                }
            }
        },
        "description": "Landing zone configuration for the Molyneux.IO platform covering subscriptions, policy, and logging, deployed with Bicep and GitHub Actions.",
        "topics": [
            "azure",
            "bicep",
            "github-actions",
            "landing-zone",
            "policy",
            "log-analytics"
        ],
        "visibility": "public"
    },
    "environments": [
        {
            "name": "Production",
            "subscription": "sub-platform-management",
            "role_assignments": {
                "assigned_roles": [
                    {
                        "roles": [
                            "Contributor"
                        ]
                    }
                ]
            }
        }
    ]
}