{
    "name": "platform-radar",
    "github": {
        "description": "Private software lifecycle and exposure intelligence platform.",
        "topics": ["dotnet", "react", "security", "software-lifecycle", "terraform"],
        "visibility": "private",
        "auto_init": true,
        "add_sonarcloud_secrets": false,
        "repository_analysis": {
            "profile": {
                "version": "repository-analysis-v1",
                "languages": ["actions", "csharp", "javascript", "shell", "terraform"],
                "sonar": false
            },
            "sonar": null,
            "cadence": {
                "dailyFreshness": true,
                "fullRescanMaximumHours": 168,
                "defaultBranchCancellation": false,
                "dispatch": {
                    "expectedRevision": true,
                    "force": true,
                    "defaultBranchOnly": true
                }
            }
        },
        "rulesets": [
            {
                "name": "main-protection",
                "target": "branch",
                "enforcement": "active",
                "includes": ["refs/heads/main"],
                "excludes": [],
                "bypass_actors": [
                    {
                        "bypass_mode": "always",
                        "actor_id": 5,
                        "actor_type": "RepositoryRole"
                    }
                ],
                "rules": {
                    "required_status_checks": [
                        {"context": "quality", "integration_id": 15368},
                        {"context": "terraform", "integration_id": 15368},
                        {"context": "container", "integration_id": 15368}
                    ],
                    "strict_required_status_checks_policy": true,
                    "do_not_enforce_on_create": false,
                    "pull_request": {
                        "allowed_merge_methods": ["merge", "rebase", "squash"],
                        "required_approving_review_count": 0,
                        "dismiss_stale_reviews_on_push": true,
                        "require_code_owner_review": false,
                        "required_review_thread_resolution": true
                    },
                    "required_code_scanning": [],
                    "required_signatures": false,
                    "required_linear_history": true,
                    "non_fast_forward": true
                }
            }
        ]
    },
    "environments": [
        {
            "name": "Production",
            "subscription": "sub-platform-management",
            "connect_to_github": true,
            "configure_for_terraform": true,
            "directory_roles": ["Cloud application administrator", "Directory Readers"],
            "role_assignments": {
                "assigned_roles": [
                    {
                        "scope": "/subscriptions/db34f572-8b71-40d6-8f99-f29a27612144/resourceGroups/rg-platform-dns-prd-uksouth-01/providers/Microsoft.Network/dnszones/molyneux.io",
                        "roles": ["DNS Zone Contributor"]
                    }
                ]
            },
            "locations": ["uksouth"],
            "resource_groups": [
                {
                    "name": "rg-{workload}-{env}-{location}",
                    "role_assignments": {
                        "assigned_roles": [
                            {"roles": ["Contributor", "Key Vault Secrets Officer"]}
                        ],
                        "rbac_admin_roles": [
                            {
                                "allowed_roles": [
                                    "Key Vault Secrets User",
                                    "Workload Key Vault Secret Synchronizer",
                                    "Cognitive Services OpenAI User"
                                ]
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
