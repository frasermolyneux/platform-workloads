{
    "name": "baremetal-workload-template",
    "github": {
        "repository_analysis": {
            "profile": {
                "version": "repository-analysis-v1",
                "languages": [
                    "actions",
                    "csharp",
                    "dockerfile",
                    "javascript",
                    "php",
                    "python",
                    "shell"
                ],
                "sonar": false
            },
            "sonar": null,
            "cadence": {
                "dailyFreshness": true,
                "fullRescanMaximumHours": 168,
                "defaultBranchCancellation": false,
                "dispatch": {
                    "expectedRevision": true,
                    "force": true,
                    "defaultBranchOnly": true
                }
            }
        },
        "description": "Canonical constrained bare-metal workload contract and application archetypes.",
        "topics": [
            "bare-metal",
            "containers",
            "dotnet",
            "nodejs",
            "php",
            "static-site",
            "template"
        ],
        "add_sonarcloud_secrets": false,
        "add_nuget_environment": false,
        "auto_init": true,
        "github_app": {
            "enabled": true,
            "app_id": "2973523",
            "installation_id": "113093932"
        },
        "is_template": true,
        "visibility": "private"
    },
    "environments": [
        {
            "name": "Production",
            "subscription": "sub-platform-management",
            "connect_to_github": true,
            "locations": [
                "swedencentral"
            ],
            "resource_groups": [
                {
                    "name": "rg-{workload}-{env}-{location}"
                }
            ]
        }
    ]
}
