{
    "name": "status-pages",
    "github": {
        "description": "Configuration and incident content for multi-tenant public status pages.",
        "topics": [
            "status-page",
            "incident-management",
            "multi-tenant",
            "configuration",
            "yaml"
        ],
        "visibility": "public",
        "inventory": {
            "state": "empty",
            "inspection": "metadata",
            "review_governance": "exempt",
            "reason": "Empty repository with no default branch; metadata is inspected and no Copilot review rule is required"
        },
        "repository_policy": {
            "copilot_code_review": {
                "enabled": false,
                "exception_reason": "Empty repository with no default branch"
            }
        },
        "has_issues": true,
        "rulesets": [
            {
                "name": "main-protection",
                "target": "branch",
                "enforcement": "active",
                "includes": [
                    "refs/heads/main"
                ],
                "excludes": [],
                "bypass_actors": [
                    {
                        "bypass_mode": "always",
                        "actor_id": 5,
                        "actor_type": "RepositoryRole"
                    }
                ],
                "rules": {
                    "pull_request": {
                        "allowed_merge_methods": [
                            "merge",
                            "rebase",
                            "squash"
                        ],
                        "required_approving_review_count": 0,
                        "dismiss_stale_reviews_on_push": true,
                        "require_code_owner_review": false,
                        "required_review_thread_resolution": true
                    },
                    "required_signatures": false,
                    "required_linear_history": true,
                    "non_fast_forward": true
                }
            }
        ],
        "labels": [
            {
                "name": "coding-agent",
                "description": "Issue or PR delegated to the GitHub Copilot coding agent",
                "color": "1D76DB"
            },
            {
                "name": "needs-triage",
                "description": "Issue or PR awaiting triage by maintainers",
                "color": "FBCA04"
            }
        ]
    }
}
