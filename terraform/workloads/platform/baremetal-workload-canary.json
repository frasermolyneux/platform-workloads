{
    "name": "baremetal-workload-canary",
    "github": {
        "description": "Disposable private canary for the constrained bare-metal workload contract.",
        "topics": [
            "bare-metal",
            "canary",
            "containers",
            "platform"
        ],
        "add_sonarcloud_secrets": false,
        "add_nuget_environment": false,
        "auto_init": true,
        "visibility": "private"
    },
    "environments": [
        {
            "name": "Production",
            "subscription": "sub-platform-management",
            "connect_to_github": true,
            "locations": [
                "swedencentral"
            ],
            "resource_groups": [
                {
                    "name": "rg-{workload}-{env}-{location}"
                }
            ]
        }
    ]
}
