{
    "name": "platform-letsencrypt-iis",
    "github": {
        "repository_analysis": {
            "profile": {
                "version": "repository-analysis-v1",
                "languages": [
                    "actions",
                    "powershell"
                ],
                "sonar": false
            },
            "sonar": null,
            "cadence": {
                "dailyFreshness": true,
                "fullRescanMaximumHours": 168,
                "defaultBranchCancellation": false,
                "dispatch": {
                    "expectedRevision": true,
                    "force": true,
                    "defaultBranchOnly": true
                }
            }
        },
        "description": "Automation scripts for issuing, renewing, and binding Let's Encrypt certificates on IIS.",
        "topics": [
            "letsencrypt",
            "iis",
            "powershell",
            "certificate-automation",
            "github-actions"
        ],
        "visibility": "public"
    },
    "environments": [
        {
            "name": "Production",
            "subscription": "sub-platform-management",
            "connect_to_github": true,
            "cloudflare_tokens": [
                {
                    "name_suffix": "cert-rotation",
                    "policies": [
                        {
                            "permission_groups": [
                                "DNS Write",
                                "Zone Read"
                            ],
                            "zone": "xtremeidiots.com"
                        },
                        {
                            "permission_groups": [
                                "DNS Write",
                                "Zone Read"
                            ],
                            "zone": "xtremeidiots.net"
                        },
                        {
                            "permission_groups": [
                                "DNS Write",
                                "Zone Read"
                            ],
                            "zone": "bishopsbees.co.uk"
                        },
                        {
                            "permission_groups": [
                                "DNS Write",
                                "Zone Read"
                            ],
                            "zone": "moanclub.com"
                        },
                        {
                            "permission_groups": [
                                "DNS Write",
                                "Zone Read"
                            ],
                            "zone": "dm-electricalservices.co.uk"
                        },
                        {
                            "permission_groups": [
                                "DNS Write",
                                "Zone Read"
                            ],
                            "zone": "bqba.co.uk"
                        }
                    ]
                }
            ]
        }
    ]
}