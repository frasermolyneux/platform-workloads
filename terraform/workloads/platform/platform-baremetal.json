{
    "name": "platform-baremetal",
    "github": {
        "description": "Secure, automated management of dedicated Linux servers, shared services, monitoring, backups, and recovery.",
        "topics": [
            "linux",
            "bare-metal",
            "server-management",
            "infrastructure-as-code",
            "terraform",
            "github-actions",
            "monitoring",
            "backups",
            "containers"
        ],
        "add_sonarcloud_secrets": false,
        "add_nuget_environment": false,
        "visibility": "private",
        "rulesets": [
            {
                "name": "main-protection",
                "target": "branch",
                "enforcement": "active",
                "includes": [
                    "refs/heads/main"
                ],
                "excludes": [],
                "bypass_actors": [
                    {
                        "bypass_mode": "always",
                        "actor_id": 5,
                        "actor_type": "RepositoryRole"
                    }
                ],
                "rules": {
                    "required_status_checks": [
                        {
                            "context": "terraform-plan-dev",
                            "integration_id": 15368
                        },
                        {
                            "context": "ansible-validation",
                            "integration_id": 15368
                        },
                        {
                            "context": "dependabot-policy",
                            "integration_id": 15368
                        },
                        {
                            "context": "devops-secure-scanning / DevOps Secure Scanning",
                            "integration_id": 15368
                        }
                    ],
                    "strict_required_status_checks_policy": true,
                    "do_not_enforce_on_create": false,
                    "pull_request": {
                        "allowed_merge_methods": [
                            "merge",
                            "rebase",
                            "squash"
                        ],
                        "required_approving_review_count": 0,
                        "dismiss_stale_reviews_on_push": true,
                        "require_code_owner_review": false,
                        "required_review_thread_resolution": true
                    },
                    "required_code_scanning": [],
                    "required_signatures": false,
                    "required_linear_history": true,
                    "non_fast_forward": true
                }
            }
        ],
        "labels": [
            {
                "name": "deploy-dev",
                "description": "Run dev Terraform plan and apply",
                "color": "0E8A16"
            },
            {
                "name": "run-prd-plan",
                "description": "Run prd Terraform plan",
                "color": "5319E7"
            }
        ]
    },
    "environments": [
        {
            "name": "Development",
            "subscription": "sub-visualstudio-enterprise",
            "connect_to_github": true,
            "configure_for_terraform": true,
            "requires_terraform_state_access": [
                "platform-monitoring"
            ],
            "locations": [
                "uksouth"
            ],
            "resource_groups": [
                {
                    "name": "rg-{workload}-{env}-{location}",
                    "role_assignments": {
                        "assigned_roles": [
                            {
                                "roles": [
                                    "Contributor",
                                    "Key Vault Secrets Officer"
                                ]
                            }
                        ],
                        "rbac_admin_roles": [
                            {
                                "allowed_roles": [
                                    "Key Vault Secrets User",
                                    "Workload Key Vault Secret Synchronizer 6cad03c1"
                                ]
                            }
                        ]
                    }
                }
            ]
        },
        {
            "name": "Production",
            "subscription": "sub-platform-management",
            "connect_to_github": true,
            "configure_for_terraform": true,
            "cloudflare_tokens": [
                {
                    "name_suffix": "dns",
                    "policies": [
                        {
                            "permission_groups": [
                                "DNS Write",
                                "Zone Read"
                            ],
                            "zone": "xtremeidiots.com"
                        }
                    ]
                }
            ],
            "requires_terraform_state_access": [
                "platform-monitoring"
            ],
            "locations": [
                "uksouth"
            ],
            "resource_groups": [
                {
                    "name": "rg-{workload}-{env}-{location}",
                    "role_assignments": {
                        "assigned_roles": [
                            {
                                "roles": [
                                    "Contributor",
                                    "Key Vault Secrets Officer",
                                    "Storage Blob Data Contributor"
                                ]
                            }
                        ],
                        "rbac_admin_roles": [
                            {
                                "allowed_roles": [
                                    "Key Vault Secrets User",
                                    "Storage Blob Data Contributor",
                                    "Workload Key Vault Secret Synchronizer 7760848c"
                                ]
                            }
                        ]
                    }
                }
            ],
            "role_assignments": {
                "assigned_roles": [
                    {
                        "scope": "workload-rg:platform-monitoring/production/rg-platform-monitoring-prd-uksouth/uksouth",
                        "roles": [
                            "Monitoring Contributor"
                        ]
                    },
                    {
                        "scope": "/subscriptions/6cad03c1-9e98-4160-8ebe-64dd30f1bbc7/resourceGroups/rg-platform-monitoring-noncritical-prd-uksouth",
                        "roles": [
                            "Monitoring Contributor"
                        ]
                    }
                ]
            }
        }
    ]
}
