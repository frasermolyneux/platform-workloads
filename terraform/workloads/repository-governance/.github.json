{
    "name": ".github",
    "github": {
        "repository_analysis": {
            "profile": {
                "version": "repository-analysis-v1",
                "languages": [
                    "actions",
                    "powershell",
                    "python"
                ],
                "sonar": false
            },
            "sonar": null,
            "cadence": {
                "dailyFreshness": true,
                "fullRescanMaximumHours": 168,
                "defaultBranchCancellation": false,
                "dispatch": {
                    "expectedRevision": true,
                    "force": true,
                    "defaultBranchOnly": true
                }
            }
        },
        "description": null,
        "topics": [],
        "visibility": "public",
        "manage_repository": false,
        "repository_policy": {
            "copilot_code_review": {
                "enabled": false,
                "exception_reason": "Default community health repository; retain manual review initially"
            }
        }
    }
}
