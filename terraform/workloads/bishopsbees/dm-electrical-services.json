{
    "name": "dm-electrical-services",
    "github": {
        "repository_analysis": {
            "profile": {
                "version": "repository-analysis-v1",
                "languages": [
                    "actions",
                    "javascript",
                    "php"
                ],
                "sonar": false
            },
            "sonar": null,
            "cadence": {
                "dailyFreshness": true,
                "fullRescanMaximumHours": 168,
                "defaultBranchCancellation": false,
                "dispatch": {
                    "expectedRevision": true,
                    "force": true,
                    "defaultBranchOnly": true
                }
            }
        },
        "description": "WordPress workload for the DM Electrical Services website hosted on the shared bare-metal platform.",
        "topics": [
            "wordpress",
            "php",
            "mysql",
            "docker",
            "bare-metal",
            "website"
        ],
        "add_sonarcloud_secrets": false,
        "add_nuget_environment": false,
        "visibility": "private"
    }
}
