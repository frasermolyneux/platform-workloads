{
    "name": "portal-cod4x-plugin",
    "github": {
        "repository_analysis": {
            "profile": {
                "version": "repository-analysis-v1",
                "languages": [
                    "actions",
                    "cpp",
                    "powershell",
                    "terraform"
                ],
                "sonar": true
            },
            "sonar": {
                "recipe": {
                    "version": 1,
                    "driver": "cpp",
                    "projectKey": "frasermolyneux_portal-cod4x-plugin",
                    "sourceDirectory": ".",
                    "coverage": "not-applicable"
                },
                "build": {
                    "kind": "cmake",
                    "configureArgs": [
                        "-DCMAKE_BUILD_TYPE=Release",
                        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
                        "-DPORTAL_COD4X_BUILD_PLUGIN_BINARY=OFF"
                    ],
                    "buildArgs": [
                        "--config",
                        "Release"
                    ],
                    "testArgs": [
                        "--output-on-failure",
                        "--build-config",
                        "Release"
                    ]
                }
            },
            "cadence": {
                "dailyFreshness": true,
                "fullRescanMaximumHours": 168,
                "defaultBranchCancellation": false,
                "dispatch": {
                    "expectedRevision": true,
                    "force": true,
                    "defaultBranchOnly": true
                }
            }
        },
        "description": "CoD4x server plugin for the XtremeIdiots portal - enhances the in-game experience and reports events to the portal APIs. Built and published to the portal-core artifact storage; installed onto servers by portal-server-agent.",
        "topics": [
            "cod4",
            "cod4x",
            "game-server",
            "plugin",
            "github-actions",
            "azure",
            "storage"
        ],
        "add_sonarcloud_secrets": true,
        "add_nuget_environment": false,
        "visibility": "public",
        "rulesets": [
            {
                "name": "main-protection",
                "target": "branch",
                "enforcement": "active",
                "includes": [
                    "refs/heads/main"
                ],
                "excludes": [],
                "bypass_actors": [
                    {
                        "bypass_mode": "always",
                        "actor_id": 5,
                        "actor_type": "RepositoryRole"
                    }
                ],
                "rules": {
                    "required_status_checks": [
                        {
                            "context": "dependabot-policy",
                            "integration_id": 15368
                        },
                        {
                            "context": "SonarCloud Code Analysis",
                            "integration_id": 12526
                        },
                        {
                            "context": "build-and-test",
                            "integration_id": 15368
                        },
                        {
                            "context": "quality / Code Quality",
                            "integration_id": 15368
                        },
                        {
                            "context": "devops-secure-scanning / DevOps Secure Scanning",
                            "integration_id": 15368
                        }
                    ],
                    "strict_required_status_checks_policy": true,
                    "do_not_enforce_on_create": false,
                    "pull_request": {
                        "allowed_merge_methods": [
                            "merge",
                            "rebase",
                            "squash"
                        ],
                        "required_approving_review_count": 0,
                        "dismiss_stale_reviews_on_push": true,
                        "require_code_owner_review": false,
                        "required_review_thread_resolution": true
                    },
                    "required_code_scanning": [
                        {
                            "tool": "CodeQL",
                            "alerts_threshold": "errors",
                            "security_alerts_threshold": "high_or_higher"
                        },
                        {
                            "tool": "SonarCloud",
                            "alerts_threshold": "errors",
                            "security_alerts_threshold": "high_or_higher"
                        }
                    ],
                    "required_signatures": false,
                    "required_linear_history": true,
                    "non_fast_forward": true
                }
            }
        ],
        "labels": [
            {
                "name": "deploy-dev",
                "description": "Build and publish the plugin to the dev artifact storage",
                "color": "0E8A16"
            },
            {
                "name": "coding-agent",
                "description": "Issue or PR delegated to the GitHub Copilot coding agent",
                "color": "1D76DB"
            },
            {
                "name": "needs-triage",
                "description": "Issue or PR awaiting triage by maintainers",
                "color": "FBCA04"
            }
        ]
    },
    "environments": [
        {
            "name": "Development",
            "subscription": "sub-visualstudio-enterprise",
            "connect_to_github": true,
            "configure_for_terraform": true,
            "requires_terraform_state_access": [
                "portal-environments"
            ],
            "locations": [
                "swedencentral"
            ],
            "resource_groups": [
                {
                    "name": "rg-{workload}-{env}-{location}",
                    "role_assignments": {
                        "assigned_roles": [
                            {
                                "roles": [
                                    "Contributor",
                                    "Storage Blob Data Contributor"
                                ]
                            }
                        ],
                        "rbac_admin_roles": [
                            {
                                "allowed_roles": [
                                    "Storage Blob Data Contributor",
                                    "Storage Blob Data Owner",
                                    "Storage Blob Data Reader"
                                ]
                            }
                        ]
                    }
                }
            ],
            "role_assignments": {
                "assigned_roles": [
                    {
                        "roles": [
                            "Reader"
                        ]
                    }
                ]
            }
        },
        {
            "name": "Production",
            "subscription": "sub-xi-portal-prd",
            "connect_to_github": true,
            "configure_for_terraform": true,
            "requires_terraform_state_access": [
                "portal-environments"
            ],
            "locations": [
                "uksouth"
            ],
            "resource_groups": [
                {
                    "name": "rg-{workload}-{env}-{location}",
                    "role_assignments": {
                        "assigned_roles": [
                            {
                                "roles": [
                                    "Contributor",
                                    "Storage Blob Data Contributor"
                                ]
                            }
                        ],
                        "rbac_admin_roles": [
                            {
                                "allowed_roles": [
                                    "Storage Blob Data Contributor",
                                    "Storage Blob Data Owner",
                                    "Storage Blob Data Reader"
                                ]
                            }
                        ]
                    }
                }
            ],
            "role_assignments": {
                "assigned_roles": [
                    {
                        "roles": [
                            "Reader"
                        ]
                    }
                ]
            }
        }
    ]
}